{
  "name": "@dev-marzahn/convex-release",
  "version": "100.1.0-next.0",
  "description": "Versioned data migrations, seeding and self-hosted Docker images for Convex apps.",
  "keywords": [
    "cli",
    "convex",
    "convex-dev",
    "data-migrations",
    "docker",
    "migrations",
    "preview-environments",
    "schema",
    "seed",
    "self-hosted"
  ],
  "homepage": "https://github.com/dev-marzahn/convex-release#readme",
  "bugs": {
    "url": "https://github.com/dev-marzahn/convex-release/issues"
  },
  "license": "MPL-2.0",
  "author": "Leon Marzahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-marzahn/convex-release.git",
    "directory": "packages/convex-release"
  },
  "bin": {
    "convex-release": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./seed": "./dist/seed.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\"",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@faker-js/faker": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@convex-dev/migrations": "catalog:",
    "@types/node": "catalog:",
    "convex": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@convex-dev/migrations": "^0.3.8",
    "convex": "^1.50.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
