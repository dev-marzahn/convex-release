{
  "name": "convex-release-monorepo",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "e2e/apps/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp run -r build && vp check && vp run -r test",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "e2e": "node e2e/run.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "@clack/prompts": "^1.9.0",
    "@convex-dev/migrations": "^0.3.8",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "convex": "^1.50.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  }
}
